{
  "name": "textbook-reader",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "oxlint --deny-warnings src vite.config.ts",
    "lint:backend": "oxlint --deny-warnings scripts",
    "typecheck": "npm run typecheck:frontend && npm run typecheck:backend",
    "typecheck:frontend": "tsc --noEmit",
    "typecheck:backend": "tsc --project tsconfig.scripts.json",
    "test": "node --experimental-strip-types --test src/app/shelf-store.test.ts src/app/ui-style.test.ts src/reader/session.test.ts src/reader/personal.test.ts src/reader/math.test.ts src/reader/text-spacing.test.ts src/reader/links/identity.test.ts src/reader/links/references.test.ts src/textbook/catalog.test.ts src/textbook/supplements.test.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "prepare:textbook": "node scripts/prepare-textbook.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/markdown": "1.8.1",
    "@supabase/supabase-js": "2.118.0",
    "codemirror": "^6.0.2",
    "d3-force": "3.0.0",
    "mathjax-full": "^3.2.1",
    "pixi.js": "8.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/d3-force": "3.0.10",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "1.90.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
