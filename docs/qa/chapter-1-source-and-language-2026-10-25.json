      "examples": [
        "ch1-growth-rate-question",
        "ch1-example-1-2-1-guide",
        "ch1-q-example-4"
      ]
    },
    {
      "comment": 2,
      "problem": "增长率解释分散到旁问和A品牌附近，百分数的必要解释藏在另一条补充中。",
      "change": "删除重复补充入口ch1-growth-rate-base，将负号、2%=2/100和第一季度这个比较对象直接写进旁问的知识栏；100部的数值例另标“补充用例”。旧位置ID保留为例2（2）的原文目标，范围覆盖季度比较和四个品牌，其他章节原有关联继续可用。",
      "examples": [
        "ch1-growth-rate-question",
        "ch1-growth-rate-base"
      ]
    },
    {
      "comment": 3,
      "problem": "用“增长量”重命名原句，给学生增加了不必要的新名词。",
      "change": "沿用“增长−0.5 kg”，直接对照题目的“减少0.5 kg”，分别说明负号和0.5 kg；同时区分体重增长的记录与当前体重。",
      "examples": [
        "ch1-growth-amount"
      ]
    }
  ],
  "additionalFindings": [
    {
      "problem": "分类回顾入口把例1中“其中”的用法当成分类定义。",
      "change": "按题目需要直接关联正整数、零、负整数以及正负分数的定义；保留“其中”的入口时明确它只解释例题用词。",
